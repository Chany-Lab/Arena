+def _to_numpy(array) -> np.ndarray:
+    return array.numpy() if hasattr(array, "numpy") and not isinstance(array, np.ndarray) else np.asarray(array)
+
+
+def _iter_sources(plan, path_expr: str):
+    """Yield ``(source_root, destination_template, source_path, env_ids)`` per asset prototype owning ``path_expr``.
+
+    Stand-in for ``cloner.query.iter_sources``, which Isaac Lab removed after Arena's pinned commit
+    (IL3.0@d061bf35 keeps only ``cloner.path`` primitives and numeric topology queries).
+    """
+    topology = plan.topology
+    members = _to_numpy(topology.world_prototypes)
+    starts = _to_numpy(topology.world_prototype_starts)
+    layout = _to_numpy(topology.world_prototype_layout)
+    source_paths = cloner.path.get_asset_prototype_paths(plan)
+    for asset_id, cfg in enumerate(plan.asset_cfgs):
+        declared = cfg.prim_path.rstrip("/")
+        source_root = source_paths[asset_id]
+        if source_root is None:
+            continue
+        if path_expr == declared:
+            suffix = ""
+        elif path_expr.startswith(declared + "/"):
+            suffix = path_expr[len(declared):]
+        else:
+            continue
+        groups = [g - 1 for g in range(len(starts) - 1) if asset_id in members[starts[g] : starts[g + 1]]]
+        if -1 in groups:
+            env_ids = tuple(range(len(layout)))
+        else:
+            env_ids = tuple(int(i) for i in np.nonzero(np.isin(layout, groups))[0])
+        if not env_ids:
+            continue
+        yield source_root, declared, source_root + suffix, env_ids
+
